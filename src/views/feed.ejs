<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - <%= user.username %>
    </title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
</head>

<body class="bg-black text-white">
    <main class="h-screen grid grid-cols-12">
        <!-- Left Sidebar -->
        <div class="col-span-3">
            <div class="flex justify-center logo mt-5">
                <a href="/api/v1/users/profile/<%= user._id %>">
                    <svg class="w-12 h-12" viewBox="0 0 501 501" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <title>Algolia mark white</title>
                        <path fill="#fff"
                            d="M250.926 0C114.306 0 2.926 110.16.956 246.32c-2 138.29 110.19 252.87 248.49 253.67 42.71.25 83.85-10.2 120.38-30.05 3.56-1.93 4.11-6.83 1.08-9.52l-23.39-20.74c-4.75-4.22-11.52-5.41-17.37-2.92-25.5 10.85-53.21 16.39-81.76 16.04-111.75-1.37-202.04-94.35-200.26-206.1 1.76-110.33 92.06-199.55 202.8-199.55h202.83v360.53l-115.08-102.25c-3.72-3.31-9.43-2.66-12.43 1.31-18.47 24.46-48.56 39.67-81.98 37.36-46.36-3.2-83.92-40.52-87.4-86.86-4.15-55.28 39.65-101.58 94.07-101.58 49.21 0 89.74 37.88 93.97 86.01.38 4.28 2.31 8.28 5.53 11.13l29.97 26.57c3.4 3.01 8.8 1.17 9.63-3.3 2.16-11.55 2.92-23.6 2.07-35.95-4.83-70.39-61.84-127.01-132.26-131.35-80.73-4.98-148.23 58.18-150.37 137.35-2.09 77.15 61.12 143.66 138.28 145.36 32.21.71 62.07-9.42 86.2-26.97l150.36 133.29c6.45 5.71 16.62 1.14 16.62-7.48V9.49c0-5.24-4.25-9.49-9.49-9.49H250.926Z">
                        </path>
                    </svg>
                </a>
            </div>
            <div class="navIcons flex justify-center mt-6">
                <ul>
                    <li class="hover:text-gray-400">
                        <a href="/api/v1/users/feed" class="hover:text-gray-400">
                            <span class="material-symbols-outlined" style="font-size: 48px;">home</span>
                        </a>
                    </li>
                    <li class="hover:text-gray-400">
                        <a href="/api/v1/users/settings" class="hover:text-gray-400">
                            <span class="material-symbols-outlined" style="font-size: 48px;">settings</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-span-6 bg-gray-800 p-4 overflow-y-auto overflow-x-hidden">
            <!-- Post Upload Section -->
            <div class="uploadPost flex items-start p-4 rounded-lg shadow-md bg-gray-700">
                <div class="profileOwner h-14 w-14 rounded-full overflow-hidden flex items-center justify-center">
                    <img src="<%= user.avatar %>" alt="<%= user.username %>'s avatar"
                        class="object-cover w-full h-full">
                </div>
                <div class="postInput ml-4 flex-1">
                    <input onclick="opennewPostModel()"
                        class="w-full h-14 p-4 rounded-lg bg-gray-100 text-black placeholder-gray-500 focus:outline-none"
                        type="text" name="postTextForm" id="postTextForm" placeholder="What's on your mind?">
                </div>
            </div>



            <!-- Posts Section -->
            <div class="border border-red-500 mt-3"></div>
            <div class="allPosts min-h-[84%]">
                <% if(posts.length===0) { %>
                    <h2 class="text-center">No posts available</h2>
                    <% } else { %>
                        <% posts.forEach(post=> { %>
                            <div class="postOne h-full">
                                <div class="postOneDetails flex items-center m-4 gap-3">
                                    <div class="postOwner h-14 w-14 rounded-full overflow-hidden">
                                        <img class="object-cover w-full h-full" src="<%= post.owner.avatar %>"
                                            alt="<%= post.owner.username %>'s avatar">
                                    </div>
                                    <div class="postOwnerDetails">
                                        <h2 class="font-bold">
                                            <%= post.owner.username %>
                                        </h2>
                                        <p>
                                            <%= new Date(post.createdAt).toLocaleString() %>
                                        </p>
                                    </div>
                                </div>

                                <div class="border border-green-500 mt-3"></div>

                                <div class="postContent p-2 shadow-lg m-5 rounded-3xl h-[45%]">
                                    <div class="postText">
                                        <p>
                                            <%= post.postText %>
                                        </p>
                                    </div>
                                    <% if(post.postPic) { %>
                                        <div class="postPic w-full overflow-hidden object-cover">
                                            <img src="<%= post.postPic %>" alt="Post image">
                                        </div>
                                        <% } %>
                                </div>
                            </div>
                            <% }) %>
                                <div class="border border-green-500 mt-3"></div>
                                <% } %>
            </div>

        </div>

        <!-- Right Sidebar -->
        <div class="col-span-3"></div>


        <!-- Upload post Model -->
        <div class="hidden uploadPostModel fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50">
            <div class="uploadPostModelContent w-full max-w-lg p-6 bg-white rounded-lg shadow-lg">
                <form action="/api/v1/users/upload" method="post" enctype="multipart/form-data">
                    <h2 class="text-lg font-bold mb-4 text-gray-800">Write Something!!!</h2>

                    <textarea
                        class="text-black w-full h-24 p-3 mb-4 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        name="postText" id="newPostText" placeholder="Share your thoughts..." required></textarea>

                    <input
                        class="block w-full text-sm text-gray-500 mb-4 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
                        type="file" name="postPic" id="newPostPic">

                    <div class="flex justify-end gap-3">
                        <button type="button" id="cancelButton"
                            class="py-2 px-4 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400">
                            Cancel
                        </button>
                        <button type="submit" class="py-2 px-4 bg-blue-500 text-white rounded-lg hover:bg-blue-600">
                            Upload
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </main>
</body>

<script>
    function opennewPostModel() {
        const uploadPostModel = document.querySelector('.uploadPostModel');
        uploadPostModel.classList.remove('hidden');

        const cancelBtn = document.getElementById('cancelButton');

        cancelBtn.addEventListener('click', () => {
            uploadPostModel.classList.add('hidden');
        });

    }
</script>

</html>